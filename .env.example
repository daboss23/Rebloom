# Rebloom environment variables.
# Copy to .env.local for local development. Everything is optional for a first run:
# with no keys at all, the app uses a local file store and fixture (sample) skin analysis.
# Never commit real values. Secrets go in Vercel's settings, never in the browser.

# ---- App ----
# Public address of the app, e.g. https://skin-hackathon-topaz-rho.vercel.app
APP_URL=
# Demo features (sandboxes, demo login, time travel). true for the hackathon.
DEMO_MODE=true
# Optional. Pins the demo calendar to a date, e.g. 2026-12-29, so a video matches the mockup.
DEMO_TODAY=

# ---- Supabase (database, login, private photo storage) ----
NEXT_PUBLIC_SUPABASE_URL=
# Public by design: the "publishable" or "anon" key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET. The "secret" or "service_role" key. Server only.
# SUPABASE_SECRET_KEY (Supabase's newer name, sb_secret_...) also works if that's what you have.
# With the URL and this key set, the app uses Supabase; without them, the local file store.
SUPABASE_SERVICE_ROLE_KEY=
# Build tooling only (pnpm db:migrate, db:seed, db:status). Never set these in Vercel.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
# Optional. "local" forces the file store even when Supabase keys are set (the browser tests use this).
REBLOOM_STORE=

# ---- YouCam skin analysis (Perfect Corp) ----
# SECRET. Server only.
YOUCAM_API_KEY=
# live = real API calls (spends units). fixture = sample results, no API calls.
YOUCAM_MODE=fixture
# "hd" (default): YouCam's HD analysis for camera photos (1080px+ on the short side), SD for smaller ones. "sd": always SD.
YOUCAM_ENGINE=hd
# Total units bought so far. Raise after a top-up so the reserve check stays right.
YOUCAM_UNIT_BUDGET=1000
# How long a fixture analysis "takes", in ms, so the processing screen can be seen.
FIXTURE_DELAY_MS=9000
# Leave empty. Only set by tests that point the app at a local stand-in for YouCam.
YOUCAM_API_BASE=

# ---- Anthropic (reads the client's own words, DECISIONS D-079) ----
# SECRET. Server only. Without it, a word list reads them instead.
ANTHROPIC_API_KEY=

# ---- Resend (email, Week 2) ----
# SECRET. Server only.
RESEND_API_KEY=
# Until a domain is verified: Rebloom <onboarding@resend.dev>
EMAIL_FROM=

# Replies from clients (DECISIONS D-081). A subdomain Resend receives on, e.g. reply.yourdomain.com: every email then
# carries the client's own reply address there, and replies land on their brief. Leave empty to keep replies going to EMAIL_FROM.
REPLY_DOMAIN=
# SECRET. whsec_... From Resend, Webhooks: endpoint https://<site>/api/resend/inbound, event email.received.
RESEND_WEBHOOK_SECRET=
# ---- Twilio (texts, DECISIONS D-080) ----
# Optional. In demo mode texts are logged in the outbox, never sent. Live texts need DEMO_MODE=false,
# all three of these, and a US number registered for business texting (A2P 10DLC or toll-free verification).
# SECRET. Server only.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The sending number (+13105550100) or a Messaging Service SID (MG...).
# Replies to texts: set the number's "A message comes in" webhook to https://<site>/api/twilio/inbound (HTTP POST).
TWILIO_FROM=
# Leave empty. Only set by tests that point the app at a local stand-in for Twilio.
TWILIO_API_BASE=

# ---- Stripe, TEST MODE ONLY (booking deposits, DECISIONS D-065) ----
# SECRET. Must start with sk_test_. The app refuses to start with a live key. Without it, booking takes no deposit.
STRIPE_SECRET_KEY=
# Not needed: deposits use Stripe's hosted Checkout page, so no Stripe key reaches the browser.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# SECRET. whsec_... From Stripe, Developers, Webhooks: endpoint https://<site>/api/stripe/webhook, events
# checkout.session.completed and checkout.session.expired. Optional: the return page confirms payments without it.
STRIPE_WEBHOOK_SECRET=
# Browser tests only: a local stand-in for Stripe. Never set in Vercel (the app refuses it in production).
STRIPE_API_BASE=

# ---- Security ----
# SECRET. Protects scheduled jobs (keep-alive, rebook engine) and the YouCam connection check.
CRON_SECRET=
# SECRET. Salt for hashing IP addresses (raw IPs are never stored). Required in production.
IP_HASH_SALT=
