# Rebloom environment variables.
# Copy to .env.local for local development. Everything is optional for a first run:
# with no keys at all, the app uses a local file store and fixture (sample) skin analysis.
# Never commit real values. Secrets go in Vercel's settings, never in the browser.

# ---- App ----
# Public address of the app, e.g. https://skin-hackathon-topaz-rho.vercel.app
APP_URL=
# Demo features (sandboxes, demo login, time travel). true for the hackathon.
DEMO_MODE=true
# Optional. Pins the demo calendar to a date, e.g. 2026-12-29, so a video matches the mockup.
DEMO_TODAY=

# ---- Supabase (database, login, private photo storage) ----
NEXT_PUBLIC_SUPABASE_URL=
# Public by design: the "publishable" or "anon" key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET. The "secret" or "service_role" key. Server only.
# SUPABASE_SECRET_KEY (Supabase's newer name, sb_secret_...) also works if that's what you have.
# With the URL and this key set, the app uses Supabase; without them, the local file store.
SUPABASE_SERVICE_ROLE_KEY=
# Build tooling only (pnpm db:migrate, db:seed, db:status). Never set these in Vercel.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
# Optional. "local" forces the file store even when Supabase keys are set (the browser tests use this).
REBLOOM_STORE=

# ---- YouCam skin analysis (Perfect Corp) ----
# SECRET. Server only.
YOUCAM_API_KEY=
# live = real API calls (spends units). fixture = sample results, no API calls.
YOUCAM_MODE=fixture
# Total units bought so far. Raise after a top-up so the reserve check stays right.
YOUCAM_UNIT_BUDGET=1000
# How long a fixture analysis "takes", in ms, so the processing screen can be seen.
FIXTURE_DELAY_MS=9000
# Leave empty. Only set by tests that point the app at a local stand-in for YouCam.
YOUCAM_API_BASE=

# ---- Anthropic (report writing, Week 2) ----
# SECRET. Server only.
ANTHROPIC_API_KEY=

# ---- Resend (email, Week 2) ----
# SECRET. Server only.
RESEND_API_KEY=
# Until a domain is verified: Rebloom <onboarding@resend.dev>
EMAIL_FROM=

# ---- Stripe, TEST MODE ONLY (deposits, Week 2) ----
# SECRET. Must start with sk_test_. The app refuses to start with a live key.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# SECRET. whsec_...
STRIPE_WEBHOOK_SECRET=

# ---- Security ----
# SECRET. Protects scheduled jobs (keep-alive, rebook engine) and the YouCam connection check.
CRON_SECRET=
# SECRET. Salt for hashing IP addresses (raw IPs are never stored). Required in production.
IP_HASH_SALT=
